# youtube_pipeline 로컬 산출물/비밀
.env

# 프로젝트 폴더의 원본 미디어와 중간/최종 산출물은 커밋하지 않는다.
# 다만 **대본과 출처는 커밋한다** — 이건 산출물이 아니라 입력이고,
# 여기 안 넣어 뒀다가 작업 디렉토리가 되돌아가면서 실제로 한 번 날아갔다.
# depth 2 의 두 파일만 예외로 두고 그 아래는 다시 전부 제외한다
projects/*
!projects/.gitkeep
!projects/*/
projects/*/*
!projects/*/script.md
!projects/*/출처.md
!projects/*/design.json
# 검수 시트는 산출물이지만 **대화에 올려 놓고 얘기하는 물건**이라 남긴다.
# 되돌아갈 때마다 30분짜리 렌더를 다시 돌리는 것보다 낫다 (한 장 2MB 안팎)
!projects/*/검수시트_*.png

# 로컬 whisper 모델 (대용량 — scripts/setup_model.py 로 재다운로드)
models/

# 수집 후보는 임시물 — fetch_sources.py 를 다시 돌리면 새로 받아지고,
# 수집할 때마다 통째로 덮인다. 채택한 자산만 커밋한다
motion/public/*/_candidates/

# 스톡 영상은 커밋하지 않는다 — 용량이 크고(편당 수백 MB)
# `fetch_sources.py --adopt` 로 언제든 다시 받을 수 있다.
# 사진·지도·JSON 은 작고 재현이 번거로우므로 그대로 둔다.
motion/public/*/*.mp4
motion/public/*/*.webm
motion/public/*/*.mov
