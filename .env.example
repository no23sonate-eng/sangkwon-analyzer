# 카카오 개발자 REST API 키 (https://developers.kakao.com)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 공공데이터포털 인증키 (https://www.data.go.kr)
DATA_GO_KR_API_KEY=your_data_go_kr_api_key_here

# 서울열린데이터광장 인증키 (https://data.seoul.go.kr)
SEOUL_OPEN_API_KEY=your_seoul_open_api_key_here

# VWorld 오픈API 인증키 (https://www.vworld.kr) — 주소→필지·용도지역 자동조회 (web/.env.local 에도 동일 키 필요)
VWORLD_API_KEY=your_vworld_api_key_here
